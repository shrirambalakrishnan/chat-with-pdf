# Port the Express server listens on (optional, defaults to 3000)
PORT=

# GCP project id
GCP_PROJECT_ID=

# Cloud Storage bucket for uploaded PDFs
GCS_BUCKET_NAME=

# Firestore database id (use "(default)" for the default database)
FIRESTORE_DATABASE_ID=

# Vertex AI region for the embedding model, e.g. us-central1
VERTEX_LOCATION=

# Embedding model for RAG ingestion
EMBEDDING_MODEL=gemini-embedding-001

# Embedding size; at most 2048 (Firestore vector limit)
EMBEDDING_DIMENSIONS=768

# Chat model that answers questions from the retrieved chunks
CHAT_MODEL=gemini-3.8-flash

# Vertex AI location for the chat model; gemini-3.8-flash is served on the
# global endpoint, not in single regions like us-central1
CHAT_LOCATION=global
